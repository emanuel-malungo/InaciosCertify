# ── Base de dados (PostgreSQL / Neon) ───────────────────────────────────────
# Runtime da aplicação: ligação "pooled"
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
# Migrações e seed: ligação direta (sem "-pooler"). Opcional em PostgreSQL local.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ── Aplicação ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Segredos (>= 32 caracteres) ─────────────────────────────────────────────
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
QR_CODE_SECRET=""
SESSION_SECRET=""

# ── Administrador inicial (npm run db:seed) ─────────────────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
