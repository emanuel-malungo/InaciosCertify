generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// AUTO = abre/fecha pela janela do dia do evento; OPEN/CLOSED = override manual do admin.
enum CheckinMode {
  AUTO
  OPEN
  CLOSED
}

enum TicketStatus {
  ACTIVE
  CLAIMED
  INVALIDATED
}

enum CertificateStatus {
  VALID
  REVOKED
}

model Event {
  id              String      @id @default(uuid())
  slug            String      @unique
  name            String
  description     String?
  timezone        String      @default("Africa/Luanda")
  startsAt        DateTime
  checkinOpensAt  DateTime
  checkinClosesAt DateTime
  checkinMode     CheckinMode @default(AUTO)

  tickets      Ticket[]
  certificates Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Ingresso (QR Code) de um participante — ligado a um dispositivo, sem login.
model Ticket {
  id          String       @id @default(uuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// HMAC do token de dispositivo. null = ainda não vinculado (ex.: QR regenerado pelo admin).
  deviceHash  String?
  /// Incrementa quando o admin regenera o QR; invalida o QR anterior.
  qrVersion   Int          @default(1)
  status      TicketStatus @default(ACTIVE)
  userAgent   String?
  ipHash      String?
  claimedAt   DateTime?
  invalidatedAt     DateTime?
  invalidatedReason String?

  certificate Certificate?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Um dispositivo só pode ter um ingresso por evento (NULLs não colidem em Postgres).
  @@unique([eventId, deviceHash])
  @@index([status])
  @@index([createdAt])
}

model Certificate {
  id               String            @id @default(uuid())
  serial           Int               @unique @default(autoincrement())
  /// Código público e não enumerável usado em /validar/<código>.
  verificationCode String            @unique
  fullName         String
  status           CertificateStatus @default(VALID)
  revokedAt        DateTime?
  revokedReason    String?
  /// Incrementa em cada regeneração feita pelo admin.
  version          Int               @default(1)
  /// SHA-256 do conteúdo canónico (código|nome|evento|emissão).
  contentHash      String

  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, status])
  @@index([fullName])
  @@index([issuedAt])
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String   // e-mail do admin, "participant" ou "system"
  action    String   // ex.: TICKET_CREATED, CERTIFICATE_ISSUED, CERTIFICATE_REVOKED
  entity    String   // "Ticket" | "Certificate" | "Event"
  entityId  String
  details   Json?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
